# Anthropic API Key (required)
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# HuggingFace API Key (required for model comparison)
# Get your API key from: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=your_huggingface_api_key_here

# GitHub Token (optional, for GitHub integration)
# Get your token from: https://github.com/settings/tokens
GITHUB_TOKEN=your_github_token_here

# Local LLM URL (optional, for Day 26 - Local AI Coach)
# Example for LM Studio: http://localhost:1234
# Make sure LM Studio is running and accessible
LOCAL_LLM_URL=http://localhost:1234

# Local Whisper URL (optional, for Day 31 - Voice Agent)
# Example: http://localhost:9000
LOCAL_WHISPER_URL=http://localhost:9000
